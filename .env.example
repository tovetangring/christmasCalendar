# Copy to .env.local and fill in from Firebase: Project settings -> Your apps -> Web app -> firebaseConfig.
# Without these the calendar runs fully locally (everything saved in the browser only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
